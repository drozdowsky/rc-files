# $FreeBSD: releng/12.0/share/skel/dot.shrc 327420 2017-12-31 06:58:58Z eadler $
#
# .shrc - bourne shell startup file 
#
# This file will be used if the shell is invoked for interactive use and
# the environment variable ENV is set to this file.
#
# see also sh(1), environ(7).
#


# file permissions: rwxr-xr-x
#
# umask	022

# Uncomment this to enable the builtin vi(1) command line editor in sh(1),
# e.g. ESC to go into visual mode.
# set -o vi

[ -f ~/.aliases ] && . ~/.aliases

# set prompt: ``username@hostname$ '' 
WHOAMI="luv"
case "$0$SHELL" in
    *zsh*)
        # zsh does not use $ENV, workaround with ln -s
        autoload -Uz colors && colors
        RED='%F{red}'
        RESET='%f'
        CATALOG='%~'
        CLOCK='%D{%H:%M:%S} '
        DURATION='${_cmd_time}s '
        setopt PROMPT_SUBST
        _cmd_time=0
        _cmd_preexec() { _cmd_start=$SECONDS }
        _cmd_precmd() {
            if [ -n "$_cmd_start" ]; then
                _cmd_time=$((SECONDS - _cmd_start))
                unset _cmd_start
            fi
        }
        autoload -Uz add-zsh-hook
        add-zsh-hook preexec _cmd_preexec
        add-zsh-hook precmd _cmd_precmd
        ;;
    *)
        RED='\[\e[31m\]'
        RESET='\[\e[0m\]'
        CATALOG='\w'
        CLOCK=''
        DURATION=''
        ;;
esac

PS1="${CLOCK}${RED}${WHOAMI}${RESET}"
case `id -u` in
	0) PS1="${PS1}:${CATALOG} ${DURATION}# ";;
	*) PS1="${PS1}:${CATALOG} ${DURATION}$ ";;
esac

# search path for cd(1)
CDPATH=.:$HOME

# non easy ctrl-d
set -o ignoreeof

# ENV=~/.shrc so source other shells depending on $0$SHELL
case "$0$SHELL" in
    *csh*)
        . ~/.cshrc
        ;;
    *ksh*)
        . ~/.kshrc 
        ;;
    *zsh*)
        # zsh does not use $ENV, workaround with ln -s
        . ~/.config/.zshrc
        ;;
    *bash*)
        . ~/.bashrc
        ;;
esac


